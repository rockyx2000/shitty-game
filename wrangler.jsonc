{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shitty-game",
	"main": ".open-next/worker.js",
	// カスタムドメインのみで公開する (Access で保護するのもこのドメインだけ)
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "game.example.com",
			"custom_domain": true
		}
	],
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"vars": {
		// Zero Trust > Settings > Custom Pages 付近に表示される team name。例: myteam.cloudflareaccess.com
		"CF_ACCESS_TEAM_DOMAIN": "<your-team>.cloudflareaccess.com",
		// Access アプリケーションの Application Audience (AUD) Tag
		"CF_ACCESS_AUD": "<your-access-aud-tag>"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shitty-game",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	]
}